+# Step 5: two blocs side by side, farm exports by destination bloc.
+# Input:  outputs/data/bloc_trade.csv  (made by 01_bloc_trade.py)
+# Output: outputs/figures/bloc_panel_eu_mercosur.png
+
+import matplotlib
+
+matplotlib.use("Agg")  # draw to a file, no window
+import matplotlib.pyplot as plt
+import pandas as pd
+
+bloc_trade = pd.read_csv("outputs/data/bloc_trade.csv")
+bloc_trade["trade_bn"] = bloc_trade["trade_usd"] / 1e9  # USD billions
+
+# The two exporting blocs to compare. Change these names to compare others.
+blocs = ["EU", "Mercosur"]
+
+# Each panel has its own y-axis: EU trade is much larger than Mercosur trade.
+fig, axes = plt.subplots(1, 2, figsize=(12, 5))
+for ax, bloc in zip(axes, blocs):
+    exports = bloc_trade[bloc_trade["bloc_from"] == bloc]
+    for partner, rows in exports.groupby("bloc_to"):
+        ax.plot(rows["year"], rows["trade_bn"], label=partner)
+    ax.set_title(f"Farm exports from {bloc}")
+    ax.set_xticks(range(2000, 2020, 5))
+    ax.set_xlabel("Year")
+    ax.set_ylabel("Trade (USD billions)")
+    ax.legend(title="To", fontsize=8)
+
+fig.tight_layout()
+fig.savefig("outputs/figures/bloc_panel_eu_mercosur.png", dpi=150)
+plt.close(fig)
+print("Saved outputs/figures/bloc_panel_eu_mercosur.png")
