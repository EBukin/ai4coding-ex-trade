# Clean data and outputs are committed in this project,
# so people without R or Stata still see every result.

# Raw downloads are too large for Git (over 600 MB).
# code/00_data_prep/prepare_data.py downloads them again.
/data/raw/*
!/data/raw/README.md

# R
.Rhistory
.RData
.Rproj.user/
renv/library/

# Python
__pycache__/
.venv/

# Office lock files
~$*

# OS
.DS_Store
Thumbs.db
