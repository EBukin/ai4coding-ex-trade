# Raw downloads (over 600 MB) go to _build/project/data/raw/, which the
# project's own .gitignore ignores. Only the two filtered extracts there
# are committed on dev (force-added), so the clean data can be rebuilt
# without downloading again. They never reach main.

# Old local download folder from before the data prep moved
/_build/raw/

# Build output
/_build/out/
*.zip

# Python, R, Stata, OS
__pycache__/
.Rhistory
.RData
*.log
*.smcl
~$*
.DS_Store
Thumbs.db
